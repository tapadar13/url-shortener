APP_ENV=development
HTTP_ADDR=:8080
BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXY_CIDRS=

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=url_shortener
MONGODB_URLS_COLLECTION=urls
MONGODB_USERS_COLLECTION=users
MONGODB_RATE_LIMITS_COLLECTION=rate_limits
MONGODB_ANALYTICS_COLLECTION=click_analytics

REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=url-shortener
REDIS_CONNECT_TIMEOUT=5s

SHORT_CODE_LENGTH=7
SHORT_CODE_MAX_RETRIES=5
REDIRECT_STATUS=302

REDIRECT_CACHE_ENABLED=false
REDIRECT_CACHE_TTL=10m
REDIRECT_CACHE_ACCESS_WORKERS=2
REDIRECT_CACHE_ACCESS_QUEUE_SIZE=1024
REDIRECT_CACHE_ACCESS_TIMEOUT=5s

ANALYTICS_WORKERS=2
ANALYTICS_QUEUE_SIZE=4096
ANALYTICS_WRITE_TIMEOUT=5s

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=1m

LOG_LEVEL=info
LOG_FORMAT=text

REQUEST_TIMEOUT=10s
MAX_REQUEST_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT=10s
