APP_ENV=development
HTTP_ADDR=:8080
BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=url_shortener
MONGODB_URLS_COLLECTION=urls
MONGODB_RATE_LIMITS_COLLECTION=rate_limits

SHORT_CODE_LENGTH=7
SHORT_CODE_MAX_RETRIES=5
REDIRECT_STATUS=302

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=1m

LOG_LEVEL=info
LOG_FORMAT=text

REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=10s
